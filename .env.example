# Copy this file to ".env" and change the values. Never commit the real .env.

# Address from which the BROWSER reaches the system: localhost on your computer,
# the public IP or domain of the cloud server in production.
PUBLIC_HOST=localhost

# Docker Hub user that owns the images (siga-ipt-backend and siga-ipt-frontend)
DOCKERHUB_USER=antojm
IMAGE_TAG=latest

POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# true: creates the demo teacher and student (docente@ipt.cl, estudiante@ipt.cl) on the first start
DEMO_DATA=true
